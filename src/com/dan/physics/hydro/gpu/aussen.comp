// aussen.comp — Schachtel auf der Karte (grobes Gitter): die Zellen außen nach einer Masse des feinen Gitters über P.dt.
// P.m = 0: je Zelle außen die Summe der Randflüsse hinein, je Randkante auf ihre Zelle und die Nachbarin verteilt wie der
// Wasserstand außen; P.m = 1: Volumen und η neu (negatives Volumen abgeschnitten).
#version 460
#extension GL_GOOGLE_include_directive : require
#include "/com/dan/physics/hydro/gpu/hydro.glsl"
#define SCHACHTEL_BINDUNG 20
#include "/com/dan/physics/hydro/gpu/schachtel.glsl"
bool nass(int c) { return vol[c] > 0.0; }
#define KOPPLUNG_BINDUNG 21
#include "/com/dan/physics/hydro/gpu/kopplung.glsl"
layout(local_size_x = 64) in;
// je Zelle außen: Anfang ihrer Einträge (nAussen + 1 Werte), dann je Eintrag Randindex · 2 (+ 1: als Nachbarin)
layout(std430, binding = 24) readonly buffer Liste { int liste[]; };
layout(std430, binding = 25) readonly buffer FlussF { float flussF[]; };
layout(std430, binding = 26) buffer Rein { float rein[]; };

void main() {
    int o = int(gl_GlobalInvocationID.x);
    if (o >= K.nAussen) return;
    if (P.m == 0) {
        float s = 0.0;
        for (int i = liste[o]; i < liste[o + 1]; i++) {
            int x = liste[K.nAussen + 1 + i], rr = x >> 1;
            float fl = float(kop[4 * rr + 1]) * flussF[kop[4 * rr]];
            if (fl == 0.0) continue;
            float w = gewicht(rr);
            s += (x & 1) != 0 ? w * fl : (1.0 - w) * fl;
        }
        rein[o] = s;
        return;
    }
    if (rein[o] == 0.0) return;
    int c = zelleO[o];
    volumenDazu(c, -rein[o] * P.dt);
}
