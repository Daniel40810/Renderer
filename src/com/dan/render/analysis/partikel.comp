#version 460
// partikel.comp – render.analysis (P11c2): Partikel in der Strömung, Runge-Kutta 2 (Mittelpunkt) in Teilschritten, mit
// Spuren aus K Punkten. Ein Partikel: kopf (x, y in Zellen, Alter s, Lebensdauer s), info (Geschwindigkeit m/s, –, –, –),
// spur[K] (Ost, Nord in m vom Ursprung des Gitters, Höhe m NHN, gültig 0/1); spur[0] ist der jetzige Ort. Das Feld
// zum Gewicht w kommt aus feldbild.comp.
// Neu gesetzt wird ein Partikel, wenn es zu alt ist, das Gitter verlässt oder trocken fällt: an einer zufälligen
// nassen Zelle; ist sie trocken, wartet es (unsichtbar) auf das nächste Bild.
#define K 8
layout(local_size_x = 64) in;
#define MIT_FELDBILD
layout(set = 0, binding = 0) uniform sampler2D FELDBILD;
struct Partikel { vec4 kopf; vec4 info; vec4 spur[K]; };
layout(std430, set = 0, binding = 1) buffer Teile { Partikel P[]; };
layout(push_constant) uniform Q {
    ivec4 n;      // nx, ny, Partikel, Bild
    vec4 g;       // dx, dy, dt (s), w
    vec4 s;       // hMin (m), schieben (0/1), Teilschritte, Lebensdauer min (s)
    vec4 t;       // Lebensdauer max (s), alle neu (0/1), –, –
} q;
#include "messblick.glsl"

bool nass(vec2 p) {
    return p.x >= 0.0 && p.y >= 0.0 && p.x <= float(q.n.x) && p.y <= float(q.n.y) && fb(p, q.n.x, q.n.y).w > q.s.x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(q.n.z)) return;
    int nx = q.n.x, ny = q.n.y;
    vec4 kopf = P[i].kopf;
    vec2 p = kopf.xy;
    bool neu = q.t.y > 0.5 || kopf.z >= kopf.w || !nass(p);
    if (neu) {
        uint c = min(uint(zufall(i, uint(q.n.w) * 2u + 1u) * float(nx * ny)), uint(nx * ny - 1));
        vec2 z = vec2(float(c % uint(nx)), float(c / uint(nx))) + vec2(zufall(i, uint(q.n.w) * 2u + 7u), zufall(i + 911u, uint(q.n.w)));
        float leben = mix(q.s.w, q.t.x, zufall(i + 31u, uint(q.n.w) * 3u));
        if (!nass(z)) {
            P[i].kopf = vec4(z, 1.0, 0.0);                 // tot: Alter ≥ Lebensdauer, nächstes Bild wieder
            for (int k = 0; k < K; k++) P[i].spur[k] = vec4(0.0);
            return;
        }
        p = z;
        kopf = vec4(z, 0.0, leben);
        vec4 a = vec4(p.x * q.g.x, p.y * q.g.y, fb(p, nx, ny).z, 1.0);
        P[i].spur[0] = a;
        for (int k = 1; k < K; k++) P[i].spur[k] = vec4(a.xyz, 0.0);
    }
    int m = max(1, int(q.s.z));
    float h = q.g.z / float(m);
    vec2 sk = 1.0 / q.g.xy;                                // m → Zellen
    for (int k = 0; k < m; k++) {
        vec2 v1 = fb(p, nx, ny).xy;
        vec2 pm = p + 0.5 * h * v1 * sk;
        vec2 v2 = fb(pm, nx, ny).xy;
        p += h * v2 * sk;
    }
    kopf.xy = p;
    kopf.z += abs(q.g.z);
    P[i].kopf = kopf;
    vec2 v = fb(p, nx, ny).xy;
    P[i].info = vec4(length(v), 0.0, 0.0, 0.0);
    vec4 jetzt = vec4(p.x * q.g.x, p.y * q.g.y, fb(p, nx, ny).z, nass(p) ? 1.0 : 0.0);
    if (q.s.y > 0.5) for (int k = K - 1; k > 0; k--) P[i].spur[k] = P[i].spur[k - 1];
    P[i].spur[0] = jetzt;
}
