#version 460
// licht.comp – render.terrain (P6b): Licht des Himmels auf eine waagerechte Fläche am Auge, E = ∫ L cos θ dω über die
// Himmelsansicht (64 × 32 Richtungen gleicher Fläche [G]); nach unten dasselbe vom Boden, aus der unteren Hälfte.
#include "/com/dan/render/terrain/gelaende.glsl"
layout(local_size_x = 64) in;
layout(set = 0, binding = 5, std430) writeonly buffer Licht { vec4 himmel; vec4 boden; };
layout(set = 0, binding = 7) uniform sampler2D ansichtT;
shared vec3 oben[64], unten[64];
void main() {
    int a = int(gl_LocalInvocationID.x);
    float h = hw.sonne.w;
    vec3 so = vec3(0.0), su = vec3(0.0);
    float phi = (float(a) + 0.5) / 64.0 * 2.0 * L_PI;
    for (int b = 0; b < 32; b++) {
        float cz = (float(b) + 0.5) / 32.0, sz = sqrt(1.0 - cz * cz);
        vec3 d = vec3(sz * sin(phi), cz, -sz * cos(phi));
        so += ansicht(ansichtT, d, h) * cz;
        d.y = -cz;
        su += ansicht(ansichtT, d, h) * cz;
    }
    float dw = 2.0 * L_PI / (64.0 * 32.0);
    oben[a] = so * dw;
    unten[a] = su * dw;
    barrier();
    if (a == 0) {
        vec3 s1 = vec3(0.0), s2 = vec3(0.0);
        for (int i = 0; i < 64; i++) { s1 += oben[i]; s2 += unten[i]; }
        himmel = vec4(s1, 0.0);
        boden = vec4(s2, 0.0);
    }
}
