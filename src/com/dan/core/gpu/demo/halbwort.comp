// halbwort.comp — Prüfkernel von GpuCheck: eine float16-Tabelle ohne die Fähigkeit float16 lesen.
// Zwei float16 liegen in einem uint; unpackHalf2x16 kann jedes Gerät.
#version 460
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Tabelle { uint wort[]; };
layout(std430, binding = 1) writeonly buffer Aus { float aus[]; };
layout(push_constant) uniform Werte { int n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(n)) return;
    vec2 paar = unpackHalf2x16(wort[i >> 1]);
    aus[i] = (i & 1u) == 0u ? paar.x : paar.y;
}
