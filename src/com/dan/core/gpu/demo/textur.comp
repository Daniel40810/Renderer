#version 460
// textur.comp – GpuCheck Teil 9 (P6a): liest ein Bild über einen Abtaster (nächster Bildpunkt) Bildpunkt für Bildpunkt.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) uniform sampler2D t;
layout(std430, set = 0, binding = 1) writeonly buffer Aus { float aus[]; };
layout(push_constant) uniform P { ivec2 groesse; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(groesse.x * groesse.y)) return;
    ivec2 p = ivec2(int(i) % groesse.x, int(i) / groesse.x);
    aus[i] = texture(t, (vec2(p) + 0.5) / vec2(groesse)).r;
}
