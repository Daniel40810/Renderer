// gruppe.comp — Prüfkernel von GpuCheck: jeder Faden schreibt die Summe von 1.0 über seine Untergruppe, also deren
// tatsächliche Größe (braucht Untergruppen-Arithmetik).
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Daten { float d[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    d[i] = subgroupAdd(1.0);
}
