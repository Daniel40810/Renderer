// pruefen.comp — für GertschGlCheck: baut Blätter aus dem seed ihres Zweigs wie die anderen Shader (gertsch.glsl, blatt)
// und schreibt sie heraus, damit der Prozessor sie mit Dickicht.Zweig.blatt vergleichen kann.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Zweige { Zweig zweig[]; };
layout(std430, binding = 9) readonly buffer Fragen { uvec2 frage[]; };     // Zweig, Blatt (8: Blätter von außen)
layout(std430, binding = 10) writeonly buffer Antworten { float antwort[]; };  // je Blatt 16 Werte
uniform uint uZahl;

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= uZahl) return;
    Blatt b = blatt(zweig[frage[k].x], frage[k].y);
    uint o = 16u * k;
    antwort[o] = b.p.x; antwort[o + 1u] = b.p.y; antwort[o + 2u] = b.p.z;
    antwort[o + 3u] = b.n.x; antwort[o + 4u] = b.n.y; antwort[o + 5u] = b.n.z;
    antwort[o + 6u] = b.a.x; antwort[o + 7u] = b.a.y; antwort[o + 8u] = b.a.z;
    antwort[o + 9u] = b.laenge; antwort[o + 10u] = b.breite; antwort[o + 11u] = b.zufall;
    antwort[o + 12u] = b.albedo.r; antwort[o + 13u] = b.albedo.g; antwort[o + 14u] = b.albedo.b; antwort[o + 15u] = b.phase;
}
